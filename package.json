{
  "name": "dsh-codex-gpt",
  "displayName": "双脑",
  "version": "0.7.6",
  "private": true,
  "description": "【双脑】DeepSeek Harness 的 Codex/GPT 桥接插件：OpenAI 官网 OAuth 登录，按会话授权调用 Codex，并在模型列表提供 ChatGPT 模型。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "codex.js",
    "usage.js",
    "network.js",
    "oauth.js",
    "llm-adapter.js",
    "client.js",
    "screenshots.json",
    "assets/*.webp",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "openai",
    "gpt"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "license": "MIT"
}
